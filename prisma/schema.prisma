// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum UserRole {
  NANNY
  PARENT
  ADMIN
}

enum VerificationStatus {
  PENDING              // account created, KYC শুরু হয়নি
  DOCUMENTS_SUBMITTED  // passport/NID upload হয়েছে
  UNDER_REVIEW         // selfie ও দেওয়া হয়ে গেছে, vendor/admin review করছে
  APPROVED
  REJECTED
}

enum DocumentType {
  PASSPORT
  NID_FRONT
  NID_BACK
  SELFIE
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

enum MembershipPlan {
  TWO_CHILD
  FOUR_CHILD
  TEN_CHILD
  TRIAL
}

// ---------- CORE USER ----------

model User {
  id                 String              @id @default(cuid())
  fullName           String
  email              String              @unique
  phoneNumber        String?             @unique
  passwordHash       String
  profilePictureUrl  String?             // Avatar upload at the top of the signup screen
  preferredLanguage  String?             @default("en")
  role               UserRole            @default(PARENT)
  isEmailVerified    Boolean             @default(false)
  isPhoneVerified    Boolean             @default(false)
  isActive           Boolean             @default(true)
  termsAccepted      Boolean             @default(true) // Checkbox for Terms & Conditions
  
  // KYC Related fields (Applicable for both Parent and Nanny)
  verificationStatus VerificationStatus  @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?             // admin userId, যে approve/reject করলো
  reviewedAt         DateTime?
  vendorApplicantId  String?             // KYC vendor (Sumsub/Veriff)-এর reference id
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // role-নির্দিষ্ট profile
  parentProfile      ParentProfile?

  otpCodes           OtpCode[]
  kycDocuments       KycDocument[]

  @@index([role])
  @@index([verificationStatus])
}

// ---------- OTP (signup screen 2: "Enter The Code") ----------

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  purpose    OtpPurpose @default(SIGNUP_VERIFICATION)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

// ---------- PARENT PROFILE (light KYC) ----------

model ParentProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationType   String?         // "mother" | "father" | "guardian"
  street         String?
  postCode       String?
  city           String?
  state          String?
  country        String?
  membershipPlan MembershipPlan? // 2 child, 4 child, 10 child, trial
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ---------- KYC DOCUMENTS (screens 4-8: passport, NID, selfie) ----------

model KycDocument {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           DocumentType
  s3Key          String       // private bucket path, presigned URL দিয়ে upload
  extractedData  Json?        // OCR result (vendor থেকে আসলে)
  isVerified     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, type])
}