model Child {
  id           String    @id @default(uuid())
  parentUserId String
  parentUser   User      @relation("ParentChildren", fields: [parentUserId], references: [id], onDelete: Cascade)
  name         String
  avatar       String?
  gender       Gender?
  birthDate    DateTime?
  weight       String?

  // Typical Daily Cycle
  wakeUpTime String?
  bedTime    String?

  // Health & Safety
  healthConditions HealthCondition[]
  additionalNotes  String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  schoolSchedules     SchoolSchedule[]
  recurringActivities RecurringActivity[]
  naps                NapWindow[]
  childSchedules      ChildSchedule[]

  // Back Relations
  nannies  NannyChildLink[]
  dayPlans DayPlan[]

  @@index([parentUserId])
}

model SchoolSchedule {
  id        String      @id @default(uuid())
  childId   String
  child     Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  days      DayOfWeek[]
  startTime String
  endTime   String

  @@index([childId])
}

model RecurringActivity {
  id        String      @id @default(uuid())
  childId   String
  child     Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  name      String
  days      DayOfWeek[]
  startTime String
  endTime   String

  @@index([childId])
}

model NapWindow {
  id        String @id @default(uuid())
  childId   String
  child     Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  startTime String
  endTime   String

  @@index([childId])
}

model NannyChildLink {
  id             String   @id @default(uuid())
  nannyUserId    String
  nannyUser      User     @relation("NannyChildren", fields: [nannyUserId], references: [id], onDelete: Cascade)
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  canViewStory   Boolean  @default(true)
  canUpdateProof Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([nannyUserId, childId])
  @@index([childId])
}
