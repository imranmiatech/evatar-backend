model DayPlan {
  id              String           @id @default(uuid())
  childId         String
  date            DateTime
  mode            DayPlanBuildMode
  status          DayPlanStatus    @default(DRAFT)
  guidedAnswers   Json?
  aiInput         Json?
  aiOutput        Json?
  title           String?
  summary         String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bedtimeStory    BedtimeStory?
  activities      DayActivity[]
  child           Child            @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
  @@index([childId, date])
  @@index([status])
}

model DayActivity {
  id                  String                    @id @default(uuid())
  dayPlanId           String
  category            String
  title               String
  description         String?
  startTime           DateTime?
  endTime             DateTime?
  status              ActivityStatus            @default(PLANNED)
  nannyNote           String?
  parentNote          String?
  proofMediaId        String?
  imageUrl            String?
  detail              Json?
  templateId          String?
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  dayPlan             DayPlan                   @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  proofMedia          MediaAsset?               @relation("DayActivityPrimaryProof", fields: [proofMediaId], references: [id])
  feedback            DayActivityFeedback?
  proofs              DayActivityProof[]
  portfolioHighlights NannyPortfolioHighlight[]

  @@index([dayPlanId, sortOrder])
  @@index([status])
  @@index([proofMediaId])
}

model BedtimeStory {
  id               String              @id @default(uuid())
  dayPlanId        String              @unique
  title            String
  storyText        String
  imagePrompt      String?
  coverImageUrl    String?
  aiProvider       String?
  aiModel          String?
  parentAudioUrl   String?
  parentAudioKey   String?
  audioDurationSec Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  dayPlan          DayPlan             @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  audioTracks      BedtimeStoryAudio[]
}

model MediaAsset {
  id                        String                    @id @default(uuid())
  ownerUserId               String
  type                      MediaType
  url                       String
  storageKey                String
  mimeType                  String?
  sizeBytes                 Int?
  durationSec               Int?
  createdAt                 DateTime                  @default(now())
  primaryProofForActivities DayActivity[]             @relation("DayActivityPrimaryProof")
  dayActivityProofs         DayActivityProof[]
  ownerUser                 User                      @relation("UserMediaAssets", fields: [ownerUserId], references: [id], onDelete: Cascade)
  nannyPortfolioHighlights  NannyPortfolioHighlight[]

  @@index([ownerUserId, type])
}

model NannyProfile {
  id                       String               @id @default(uuid())
  userId                   String               @unique
  headline                 String?
  bio                      String?
  hourlyRateCents          Int?
  completedJobs            Int                  @default(0)
  repeatFamilies           Int                  @default(0)
  skills                   String[]             @default([])
  training                 String[]             @default([])
  languages                String[]             @default([])
  portfolioImageUrls       String[]             @default([])
  experience               Json?
  perks                    Json?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  averageRating            Float?
  backgroundCheckVerified  Boolean              @default(false)
  emergencyContactVerified Boolean              @default(false)
  joinedAt                 DateTime?
  status                   NannyProfileStatus   @default(ACTIVE)
  totalReviews             Int                  @default(0)
  yearsExperience          Int?
  certifications           NannyCertification[]
  experiences              NannyExperience[]
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DayActivityFeedback {
  id                String              @id @default(uuid())
  dayActivityId     String              @unique
  submittedByUserId String
  enjoyment         TaskEnjoymentLevel?
  childMood         ChildMood?
  completionRate    TaskCompletionRate?
  note              String?
  submittedAt       DateTime            @default(now())
  parentSeenAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  dayActivity       DayActivity         @relation(fields: [dayActivityId], references: [id], onDelete: Cascade)
  submittedByUser   User                @relation("UserSubmittedDayActivityFeedbacks", fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@index([submittedByUserId, submittedAt])
}

model DayActivityProof {
  id               String      @id @default(uuid())
  dayActivityId    String
  mediaAssetId     String
  uploadedByUserId String
  caption          String?
  createdAt        DateTime    @default(now())
  dayActivity      DayActivity @relation(fields: [dayActivityId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  uploadedByUser   User        @relation("UserUploadedDayActivityProofs", fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([dayActivityId])
  @@index([mediaAssetId])
  @@index([uploadedByUserId, createdAt])
}

model BedtimeStoryAudio {
  id             String       @id @default(uuid())
  bedtimeStoryId String
  speakerUserId  String?
  speakerName    String
  audioUrl       String
  audioKey       String?
  durationSec    Int?
  transcript     String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bedtimeStory   BedtimeStory @relation(fields: [bedtimeStoryId], references: [id], onDelete: Cascade)
  speakerUser    User?        @relation("UserBedtimeStoryAudios", fields: [speakerUserId], references: [id])

  @@index([bedtimeStoryId, sortOrder])
  @@index([speakerUserId])
}

model NannyPortfolioHighlight {
  id            String       @id @default(uuid())
  nannyUserId   String
  mediaAssetId  String?
  childId       String?
  dayActivityId String?
  title         String?
  description   String?
  imageUrl      String?
  isFeatured    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  child         Child?       @relation(fields: [childId], references: [id])
  dayActivity   DayActivity? @relation(fields: [dayActivityId], references: [id])
  mediaAsset    MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  nannyUser     User         @relation("UserNannyPortfolioHighlights", fields: [nannyUserId], references: [id], onDelete: Cascade)

  @@index([nannyUserId, createdAt])
  @@index([childId])
  @@index([dayActivityId])
}

model NannyExperience {
  id             String       @id @default(uuid())
  nannyProfileId String
  familyName     String
  startDate      DateTime?
  endDate        DateTime?
  childrenCount  Int?
  infantsCount   Int?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  nannyProfile   NannyProfile @relation(fields: [nannyProfileId], references: [id], onDelete: Cascade)

  @@index([nannyProfileId])
}

model NannyCertification {
  id             String       @id @default(uuid())
  nannyProfileId String
  title          String
  issuer         String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  documentUrl    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  nannyProfile   NannyProfile @relation(fields: [nannyProfileId], references: [id], onDelete: Cascade)

  @@index([nannyProfileId])
}
