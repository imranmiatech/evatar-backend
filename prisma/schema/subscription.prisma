model SubscriptionPlan {
  id          String               @id @default(uuid())
  name        String
  maxChildren Int
  price       Float
  currency    String               @default("AED")
  interval    SubscriptionInterval @default(MONTHLY)
  savingsText String?
  features    String[]
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  planId             String
  status             SubscriptionStatus @default(FREE_TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime?

  // Pause details
  isPaused           Boolean            @default(false)
  pausedAt           DateTime?
  resumeAt           DateTime?
  pauseDurationWeeks Int?

  // Cancellation details
  isCancelled        Boolean            @default(false)
  cancelledAt        DateTime?
  accessEndsAt       DateTime?

  // Payment failure details
  isPaymentFailed    Boolean            @default(false)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("user_subscriptions")
}

model SubscriptionCancelFeedback {
  id             String             @id @default(uuid())
  userId         String
  subscriptionId String?
  reason         CancellationReason
  detailNote     String?
  createdAt      DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_cancel_feedbacks")
}

model SubscriptionInvoice {
  id            String            @id @default(uuid())
  userId        String
  planName      String
  amount        Float
  currency      String            @default("AED")
  status        TransactionStatus @default(SUCCESS)
  failureReason String?
  invoiceDate   DateTime          @default(now())
  invoiceUrl    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_invoices")
}
