model KitchenAccess {
  id                    String   @id @default(cuid())
  parentUserId          String
  parentUser            User     @relation("KitchenAccessParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  nannyUserId           String
  nannyUser             User     @relation("KitchenAccessNanny", fields: [nannyUserId], references: [id], onDelete: Cascade)
  childId               String
  child                 Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  canViewInventory      Boolean  @default(true)
  canManageInventory    Boolean  @default(true)
  canCreateShoppingList Boolean  @default(true)
  canSendVoucher        Boolean  @default(true)
  canConfirmDelivery    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([nannyUserId, childId])
  @@index([parentUserId])
  @@index([childId])
}

model KitchenItem {
  id                  String                     @id @default(cuid())
  parentUserId        String
  parentUser          User                       @relation("KitchenInventoryParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  createdByUserId     String
  createdByUser       User                       @relation("KitchenInventoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  lastUpdatedByUserId String?
  lastUpdatedByUser   User?                      @relation("KitchenInventoryUpdatedBy", fields: [lastUpdatedByUserId], references: [id], onDelete: SetNull)
  name                String
  unit                String?
  quantity            Float?
  category            KitchenItemCategory        @default(OTHER)
  status              KitchenInventoryItemStatus @default(IN_STOCK)
  currentStockPercent Int                        @default(100)
  expiryDate          DateTime?
  lastStockedAt       DateTime?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  // Back Relations
  shoppingListItems ShoppingListItem[]

  @@index([parentUserId])
  @@index([createdByUserId])
  @@map("kitchen_items")
}

model ShoppingList {
  id              String   @id @default(cuid())
  childId         String
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  parentUserId    String
  parentUser      User     @relation("ShoppingListParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation("ShoppingListCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  title           String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items    ShoppingListItem[]
  vouchers ShoppingVoucher[]

  @@index([childId, isActive])
  @@index([parentUserId])
}

model ShoppingListItem {
  id              String                 @id @default(cuid())
  shoppingListId  String
  shoppingList    ShoppingList           @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   KitchenItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  recipeId        String?
  recipe          Recipe?                @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name            String
  unit            String?
  quantity        Float?
  category        KitchenItemCategory    @default(OTHER)
  status          ShoppingListItemStatus @default(NEEDED)
  note            String?
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  voucherItems ShoppingVoucherItem[]

  @@index([shoppingListId, status])
}

model KitchenStore {
  id               String   @id @default(cuid())
  name             String
  phoneNumber      String?
  address          String?
  deliveryFeeCents Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vouchers ShoppingVoucher[]
  orders   GroceryOrder[]
}

model ShoppingVoucher {
  id                String                @id @default(cuid())
  voucherCode       String                @unique
  childId           String
  child             Child                 @relation(fields: [childId], references: [id], onDelete: Cascade)
  parentUserId      String
  parentUser        User                  @relation("ShoppingVoucherParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdByUser     User                  @relation("ShoppingVoucherCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  shoppingListId    String?
  shoppingList      ShoppingList?         @relation(fields: [shoppingListId], references: [id], onDelete: SetNull)
  storeId           String?
  store             KitchenStore?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  status            ShoppingVoucherStatus @default(DRAFT)
  messageToParent   String?
  messageToStore    String?
  allergyWarnings   String[]              @default([])
  substitutionRules Json?
  sentToParentAt    DateTime?
  sentToStoreAt     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  items ShoppingVoucherItem[]
  order GroceryOrder?

  @@index([childId, status])
  @@index([parentUserId])
}

model ShoppingVoucherItem {
  id                  String            @id @default(cuid())
  voucherId           String
  voucher             ShoppingVoucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  shoppingListItemId  String?
  shoppingListItem    ShoppingListItem? @relation(fields: [shoppingListItemId], references: [id], onDelete: SetNull)
  recipeId            String?
  recipe              Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name                String
  unit                String?
  quantity            Float?
  estimatedPriceCents Int?
  note                String?
  sortOrder           Int               @default(0)

  @@index([voucherId])
}

model GroceryOrder {
  id               String             @id @default(cuid())
  orderNumber      String             @unique
  voucherId        String?            @unique
  voucher          ShoppingVoucher?   @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  childId          String
  child            Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  parentUserId     String
  parentUser       User               @relation("GroceryOrderParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  createdByUserId  String
  createdByUser    User               @relation("GroceryOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  storeId          String?
  store            KitchenStore?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  paymentMethodId  String?
  paymentMethod    PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  status           GroceryOrderStatus @default(VOUCHER_SENT)
  subtotalCents    Int                @default(0)
  deliveryFeeCents Int                @default(0)
  discountCents    Int                @default(0)
  totalCents       Int                @default(0)
  trackingEvents   Json?
  confirmedAt      DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  items GroceryOrderItem[]

  @@index([childId, status])
  @@index([parentUserId])
}
model GroceryOrderItem {
  id         String       @id @default(cuid())
  orderId    String
  order      GroceryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipeId   String?
  recipe     Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name       String
  unit       String?
  quantity   Float?
  priceCents Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

model PaymentMethod {
  id           String              @id @default(cuid())
  parentUserId String
  parentUser   User                @relation("PaymentMethodParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  type         PaymentMethodType
  status       PaymentMethodStatus @default(ACTIVE)
  label        String
  brand        String?
  last4        String?
  expiryMonth  Int?
  expiryYear   Int?
  providerRef  String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  orders GroceryOrder[]

  @@index([parentUserId, status])
}

model KitchenSchedule {
  id              String         @id @default(cuid())
  childId         String
  child           Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  parentUserId    String
  parentUser      User           @relation("KitchenScheduleParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User           @relation("KitchenScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  recipeId        String?
  recipe          Recipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  dayActivityId   String?
  date            DateTime
  mealType        RecipeMealType
  title           String
  notes           String?
  startTime       DateTime?
  endTime         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([childId, date])
  @@index([parentUserId])
}

model KitchenAuditLog {
  id         String   @id @default(cuid())
  childId    String?
  child      Child?   @relation(fields: [childId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation("KitchenAuditUser", fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([childId])
  @@index([userId, action])
}