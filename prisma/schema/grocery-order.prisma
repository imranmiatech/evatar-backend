model GroceryOrder {
  id               String             @id @default(uuid())
  userId           String
  storeId          String
  orderId          String?            @unique
  trackingCode     String?            @unique
  status           GroceryOrderStatus @default(VOUCHER_SENT)
  finalNote        String?
  deliveryAddress  String?
  receiverPhone    String?
  estimatedDeliveryAt DateTime?
  rewardCouponCode String?
  subtotal         Float              @default(0)
  onlineDiscount   Float              @default(0)
  deliveryFee      Float              @default(0)
  total            Float              @default(0)
  paymentType      PaymentMethodType?
  transactionId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  items            GroceryOrderItem[]
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@map("grocery_orders")
}

model GroceryOrderItem {
  id             String              @id @default(uuid())
  groceryOrderId String
  name           String
  unit           ItemUnit
  quantity       String
  category       KitchenItemCategory
  note           String?
  price          Float               @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  groceryOrder   GroceryOrder        @relation(fields: [groceryOrderId], references: [id], onDelete: Cascade)

  @@map("grocery_order_items")
}
