model ShoppingListItem {
  id              String                 @id @default(uuid())
  userId          String
  createdByUserId String?
  name            String
  unit            ItemUnit               @default(OTHER)
  quantity        String
  category        KitchenItemCategory
  note            String?
  status          ShoppingListItemStatus @default(NEEDED)
  isCustomOrder   Boolean                @default(false)
  addedToKitchen  Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdByUser   User?                  @relation("ShoppingListItemCreatedBy", fields: [createdByUserId], references: [id])
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdByUserId])
  @@index([status])
  @@index([isCustomOrder])
  @@map("shopping_list_items")
}
