model Recipe {
  id               String             @id @default(uuid())
  title            String
  imageUrl         String?
  recipeMealType   RecipeMealType
  minAgeMonths     Int?
  maxAgeMonths     Int?
  prepTimeMin      Int?
  cookTimeMin      Int?
  difficulty       Difficulty?
  servings         String?
  nutritionalFocus String[]
  safetyNotes      String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  childSchedules   ChildSchedule[]
  ingredients      RecipeIngredient[]
  steps            RecipeStep[]

  @@index([recipeMealType])
  @@map("recipes")
}

model RecipeIngredient {
  id         String  @id @default(uuid())
  recipeId   String
  name       String
  amount     String
  substitute String?
  isOptional Boolean @default(false)
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String @id @default(uuid())
  recipeId    String
  stepNumber  Int
  description String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_steps")
}
