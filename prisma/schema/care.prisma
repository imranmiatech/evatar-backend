model CareModule {
  id                 String                @id @default(uuid())
  title              String
  shortDescription   String?
  moduleDescriptions Json                  @default("[]")
  coverImageUrl      String?
  category           CareModuleCategory
  completionPoints   Int                   @default(50)
  isPublished        Boolean               @default(false)
  createdByUserId    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  ageGroup           String?
  adminStatus        CareModuleAdminStatus @default(DRAFT)
  videoUrl           String?
  keyTakeaway        String?
  progresses         CareModuleProgress[]
  saves              CareModuleSave[]
  createdByUser      User?                 @relation("CareModulesCreatedBy", fields: [createdByUserId], references: [id])
  questions          CareQuizQuestion[]

  @@index([category, isPublished, createdAt])
  @@index([ageGroup, isPublished])
  @@index([isPublished, createdAt])
  @@map("care_modules")
}

model CareChildNote {
  id           String   @id @default(uuid())
  childId      String
  authorUserId String
  note         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  authorUser   User     @relation("CareChildNotesAuthored", fields: [authorUserId], references: [id], onDelete: Cascade)
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("care_child_notes")
}

model CareQuizQuestion {
  id          String           @id @default(uuid())
  moduleId    String
  question    String
  type        CareQuestionType @default(SINGLE_CHOICE)
  explanation String
  sortOrder   Int              @default(0)
  answers     CareQuizAnswer[]
  options     CareQuizOption[]
  module      CareModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, sortOrder])
  @@map("care_quiz_questions")
}

model CareQuizOption {
  id         String           @id @default(uuid())
  questionId String
  label      String
  isCorrect  Boolean          @default(false)
  sortOrder  Int              @default(0)
  answers    CareQuizAnswer[]
  question   CareQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
  @@map("care_quiz_options")
}

model CareModuleProgress {
  id              String                   @id @default(uuid())
  moduleId        String
  userId          String
  status          CareModuleProgressStatus @default(IN_PROGRESS)
  startedAt       DateTime?
  completedAt     DateTime?
  score           Int?
  totalQuestions  Int?
  correctAnswers  Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  pointsEarned    Int                      @default(0)
  pointsAwardedAt DateTime?
  assignedById    String?
  module          CareModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user            User                     @relation("CareModuleProgressesUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy      User?                    @relation("CareModuleProgressesAssignedBy", fields: [assignedById], references: [id])
  answers         CareQuizAnswer[]

  @@unique([moduleId, userId])
  @@index([userId, status, createdAt])
  @@map("care_module_progress")
}

model CareQuizAnswer {
  id               String             @id @default(uuid())
  progressId       String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  answeredAt       DateTime           @default(now())
  progress         CareModuleProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  question         CareQuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   CareQuizOption     @relation(fields: [selectedOptionId], references: [id])

  @@unique([progressId, questionId])
  @@index([progressId])
  @@index([questionId])
  @@map("care_quiz_answers")
}

model CareModuleSave {
  id        String     @id @default(uuid())
  moduleId  String
  userId    String
  createdAt DateTime   @default(now())
  module    CareModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      User       @relation("CareModuleSaves", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId])
  @@index([userId, createdAt])
  @@map("care_module_saves")
}
