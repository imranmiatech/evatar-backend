model User {
  id                 String             @id @default(cuid())
  fullName           String
  email              String             @unique
  phoneNumber        String?            @unique
  relationShip       String?
  passwordHash       String
  profilePictureUrl  String?
  preferredLanguage  String?            @default("en")
  role               UserRole           @default(PARENT)
  isEmailVerified    Boolean            @default(false)
  isPhoneVerified    Boolean            @default(false)
  isActive           Boolean            @default(true)
  termsAccepted      Boolean            @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  vendorApplicantId  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  parentProfile            ParentProfile?
  nannyProfile             NannyProfile?
  accountDeletion          AccountDeletion?
  otpCodes                 OtpCode[]
  kycDocuments             KycDocument[]
  children                 Child[]                   @relation("ParentChildren")
  childSchedules           ChildSchedule[]           @relation("UserChildSchedules")
  nannyChildLinks          NannyChildLink[]          @relation("NannyChildren")
  mediaAssets              MediaAsset[]              @relation("UserMediaAssets")
  kitchenItems             KitchenItem[]
  kitchenInventoryCreated  KitchenItem[]             @relation("KitchenInventoryCreatedBy")
  kitchenInventoryUpdated  KitchenItem[]             @relation("KitchenInventoryUpdatedBy")
  shoppingListItems        ShoppingListItem[]
  groceryOrders            GroceryOrder[]
  paymentMethods           PaymentMethod[]
  stores                   Store[]
  supportTickets           SupportTicket[]
  ticketMessages           TicketMessage[]
  createdConversations     Conversation[]            @relation("ConversationCreatedBy")
  conversationParticipants ConversationParticipant[]
  chatMessages             ChatMessage[]

  @@index([role])
  @@index([verificationStatus])
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  purpose    OtpPurpose @default(SIGNUP_VERIFICATION)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model ParentProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationType   String?
  street         String?
  postCode       String?
  city           String?
  state          String?
  country        String?
  membershipPlan MembershipPlan?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
