model KitchenItem {
  id                  String                     @id @default(uuid())
  userId              String
  createdByUserId     String
  lastUpdatedByUserId String?
  name                String
  unit                String?
  quantity            Float?
  category            KitchenItemCategory        @default(OTHER)
  status              KitchenInventoryItemStatus @default(IN_STOCK)
  currentStockPercent Int                        @default(100)
  isArchived          Boolean                    @default(false)
  expiryDate          DateTime?
  lastStockedAt       DateTime?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  createdByUser       User                       @relation("KitchenInventoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  lastUpdatedByUser   User?                      @relation("KitchenInventoryUpdatedBy", fields: [lastUpdatedByUserId], references: [id])
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdByUserId])
  @@index([category])
  @@index([isArchived])
  @@map("kitchen_items")
}
