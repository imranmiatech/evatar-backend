model RewardAccount {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  lifetimeSpent  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
  @@map("reward_accounts")
}

model RewardLedgerEntry {
  id           String                 @id @default(uuid())
  userId       String
  entryType    RewardLedgerEntryType
  sourceType   RewardLedgerSourceType
  sourceId     String
  points       Int
  balanceAfter Int
  description  String?
  metadata     Json?
  createdAt    DateTime               @default(now())
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryType, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([entryType, createdAt])
  @@index([sourceType, sourceId])
  @@map("reward_ledger_entries")
}

model RewardOffer {
  id                  String                @id @default(uuid())
  partnerUserId       String
  storeId             String?
  title               String
  productName         String
  description         String?
  imageUrl            String?
  pointsCost          Int
  availableQuantity   Int?
  redeemedCount       Int                   @default(0)
  status              RewardOfferStatus     @default(DRAFT)
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  includedTitle       String?
  includedDescription String?
  terms               String?
  channel             RewardOfferChannel    @default(BOTH)
  onlineCouponCode    String?
  websiteUrl          String?
  locations           RewardOfferLocation[]
  stores              RewardOfferStore[]
  partnerUser         User                  @relation("PartnerRewardOffers", fields: [partnerUserId], references: [id], onDelete: Cascade)
  store               Store?                @relation(fields: [storeId], references: [id])
  redemptions         RewardRedemption[]
  savedByUsers        RewardSavedOffer[]

  @@index([partnerUserId, status, createdAt])
  @@index([storeId])
  @@index([status, startsAt, endsAt])
  @@index([channel, status])
  @@map("reward_offers")
}

model RewardOfferStore {
  id        String      @id @default(uuid())
  offerId   String
  storeId   String
  createdAt DateTime    @default(now())
  offer     RewardOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([offerId, storeId])
  @@index([offerId])
  @@index([storeId])
  @@map("reward_offer_stores")
}

model RewardOfferLocation {
  id        String      @id @default(uuid())
  offerId   String
  name      String
  address   String?
  city      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  offer     RewardOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("reward_offer_locations")
}

model RewardSavedOffer {
  id        String      @id @default(uuid())
  userId    String
  offerId   String
  createdAt DateTime    @default(now())
  offer     RewardOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId, createdAt])
  @@index([offerId])
  @@map("reward_saved_offers")
}

model RewardRedemption {
  id                  String                 @id @default(uuid())
  userId              String
  offerId             String
  code                String                 @unique
  pointsSpent         Int
  status              RewardRedemptionStatus @default(ACTIVE)
  redeemedAt          DateTime               @default(now())
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  claimMethod         RewardClaimMethod      @default(ONLINE)
  couponCode          String?
  qrToken             String?                @unique
  qrPayload           String?
  usedByPartnerUserId String?
  offer               RewardOffer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  usedByPartnerUser   User?                  @relation("PartnerUsedRewardRedemptions", fields: [usedByPartnerUserId], references: [id])
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([offerId, status])
  @@index([code])
  @@index([qrToken])
  @@index([status, expiresAt])
  @@index([claimMethod, status])
  @@map("reward_redemptions")
}
