model User {
  id                            String                       @id @default(uuid())
  fullName                      String
  email                         String                       @unique
  phoneNumber                   String?                      @unique
  relationShip                  String?
  passwordHash                  String
  profilePictureUrl             String?
  preferredLanguage             String?                      @default("en")
  role                          UserRole                     @default(PARENT)
  isEmailVerified               Boolean                      @default(false)
  isPhoneVerified               Boolean                      @default(false)
  termsAccepted                 Boolean                      @default(true)
  verificationStatus            VerificationStatus           @default(PENDING)
  rejectionReason               String?
  reviewedBy                    String?
  reviewedAt                    DateTime?
  vendorApplicantId             String?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  status                        UserStatus                   @default(PENDING)
  accountDeletion               AccountDeletion?
  bedtimeStoryAudios            BedtimeStoryAudio[]          @relation("UserBedtimeStoryAudios")
  sentCaregiverInvites          CaregiverAccess[]            @relation("CaregiverAccessInvitedBy")
  caregiverAccesses             CaregiverAccess[]            @relation("CaregiverAccessInvitedUser")
  chatMessages                  ChatMessage[]
  child                         Child[]                      @relation("ParentChildren")
  createdConversations          Conversation[]               @relation("ConversationCreatedBy")
  conversationParticipants      ConversationParticipant[]
  submittedDayActivityFeedbacks DayActivityFeedback[]        @relation("UserSubmittedDayActivityFeedbacks")
  uploadedDayActivityProofs     DayActivityProof[]           @relation("UserUploadedDayActivityProofs")
  kycVerifications              KycVerification[]
  mediaAssets                   MediaAsset[]                 @relation("UserMediaAssets")
  nannyChildLinks               NannyChildLink[]             @relation("NannyChildren")
  nannyPortfolioHighlights      NannyPortfolioHighlight[]    @relation("UserNannyPortfolioHighlights")
  nannyProfile                  NannyProfile?
  otpCodes                      OtpCode[]
  partnerProfile                PartnerProfile?
  partnerOffers                 PartnerOffer[]
  partnerOfferViews             PartnerOfferView[]
  partnerOfferSaves             PartnerOfferSave[]
  partnerOfferRedemptions       PartnerOfferRedemption[]
  parentProfile                 ParentProfile?
  partnerProducts               PartnerProduct[]
  supportTickets                SupportTicket[]
  ticketMessages                TicketMessage[]
  authoredCareChildNotes        CareChildNote[]              @relation("CareChildNotesAuthored")
  careModuleProgresses          CareModuleProgress[]         @relation("CareModuleProgressesUser")
  assignedCareModuleProgresses  CareModuleProgress[]         @relation("CareModuleProgressesAssignedBy")
  savedCareModules              CareModuleSave[]             @relation("CareModuleSaves")
  createdCareModules            CareModule[]                 @relation("CareModulesCreatedBy")
  childSchedules                ChildSchedule[]              @relation("UserChildSchedules")
  groceryOrders                 GroceryOrder[]
  kitchenInventoryCreated       KitchenItem[]                @relation("KitchenInventoryCreatedBy")
  kitchenInventoryUpdated       KitchenItem[]                @relation("KitchenInventoryUpdatedBy")
  kitchenItems                  KitchenItem[]
  paymentMethods                PaymentMethod[]
  rewardAccount                 RewardAccount?
  rewardLedgerEntries           RewardLedgerEntry[]
  rewardOffers                  RewardOffer[]                @relation("PartnerRewardOffers")
  usedRewardRedemptions         RewardRedemption[]           @relation("PartnerUsedRewardRedemptions")
  rewardRedemptions             RewardRedemption[]
  rewardSavedOffers             RewardSavedOffer[]
  createdShoppingListItems      ShoppingListItem[]           @relation("ShoppingListItemCreatedBy")
  shoppingListItems             ShoppingListItem[]
  stores                        Store[]
  subscriptionFeedbacks         SubscriptionCancelFeedback[]
  subscriptionInvoices          SubscriptionInvoice[]
  transactions                  Transaction[]
  userSubscription              UserSubscription?
  notifications                 Notification[]
  deviceTokens                  UserDeviceToken[]
  sentNannyTips                 NannyTip[]                  @relation("SentNannyTips")
  receivedNannyTips             NannyTip[]                  @relation("ReceivedNannyTips")

  @@index([role])
  @@index([verificationStatus])
}
