model Store {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  logoUrl     String?
  description String?
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  mapUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders              GroceryOrder[]
  rewardOffers        RewardOffer[]
  rewardOfferBranches RewardOfferStore[]

  @@index([userId, createdAt])
  @@map("stores")
}
