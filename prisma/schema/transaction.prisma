model Transaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groceryOrderId String?
  groceryOrder   GroceryOrder? @relation(fields: [groceryOrderId], references: [id], onDelete: SetNull)

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  transactionId     String            @unique
  paymentGateway    PaymentGateway    @default(STRIPE)
  paymentMethodType PaymentMethodType @default(ONLINE)

  amount   Float
  currency String            @default("USD")
  status   TransactionStatus @default(PENDING)

  cardBrand       String?
  cardLast4       String?
  paymentIntentId String?
  gatewayResponse String?
  failureReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([groceryOrderId])
  @@index([status])
  @@map("transactions")
}
