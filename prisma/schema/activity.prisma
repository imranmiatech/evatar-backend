model Activity {
  id               String                @id @default(uuid())
  title            String
  imageUrl         String?
  activityType     ActivityType
  minAgeMonths     Int?
  maxAgeMonths     Int?
  durationMin      Int?
  durationMax      Int?
  energyLevel      EnergyLevel?
  location         ActivityLocation[]
  connectionMoment String?
  whyThisActivity  String?
  caregiverPrompts String[]
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  benefits         ActivityBenefit[]
  progressions     ActivityProgression[]
  steps            ActivityStep[]
  childSchedules   ChildSchedule[]

  @@index([title])
  @@index([activityType])
  @@index([minAgeMonths, maxAgeMonths])
  @@map("activities")
}

model ActivityBenefit {
  id          String   @id @default(uuid())
  activityId  String
  title       String
  description String
  iconUrl     String?
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("activity_benefits")
}

model ActivityStep {
  id          String   @id @default(uuid())
  activityId  String
  stepNumber  Int
  description String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("activity_steps")
}

model ActivityProgression {
  id          String   @id @default(uuid())
  activityId  String
  level       Int
  description String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("activity_progressions")
}

model ActivityTemplate {
  id          String   @id @default(uuid())
  slug        String   @unique
  category    String
  title       String
  description String
  imageUrl    String?
  detail      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}
